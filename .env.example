# Copy this file to .env for local development.
# Do not commit real credentials.

LAKEBASE_URL=

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

WEATHER_DOCUMENTS_TABLE=weather_documents
WEATHER_EMBEDDINGS_TABLE=weather_embeddings
WEATHER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WEATHER_EMBEDDING_DIM=384
WEATHER_CHUNK_SIZE=800
WEATHER_CHUNK_OVERLAP=100
WEATHER_EMBED_BATCH_SIZE=32
WEATHER_DEFAULT_LOCATIONS=Chicago, IL;Austin, TX
NWS_USER_AGENT=weather-intelligence-lakebase-app/1.0 (your-email@example.com)
